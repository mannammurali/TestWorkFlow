[sqlfluff]
dialect = tsql           # Transact-SQL
templater = jinja        # optional, if you use templating
exclude_rules = L009      # optional: disable specific rules if needed
indent_unit = space
tab_space_size = 4
verbose = 1

[sqlfluff:rules]
max_line_length = 120
comma_style = leading     # commas at start of line
allow_scalar_equality = True

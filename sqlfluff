[sqlfluff]
templater = jinja
dialect = tsql
indent_unit = tab
tab_space_size = 4
verbose = 0

[sqlfluff:rules]
# Only apply rules that change indentation and spacing
L003 = True    # Indentation
L004 = True    # Inconsistent capitalisation (optional)
L006 = True    # Comma placement
L009 = True    # Joins formatting
# Disable all other rules

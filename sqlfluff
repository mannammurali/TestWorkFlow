[sqlfluff]
dialect = tsql  # Set dialect to T-SQL (if you're working with SQL Server)

# Rules to fix common formatting issues (indentation, commas, joins, etc.)
rules = L003, L006, L009

# Disable some other rules that may remove blank lines or modify structure
exclude_rules = L010  # Line length, so it doesn't remove blank lines
max_line_length = 120  # Set a max line length, if you want to allow some wider lines

# Optional - Customize other rules you may want to keep:
# L004 - Capitalization consistency
# L002 - Indentation should be 4 spaces (default, can be customized)
# L005 - Consistent quotes for strings (if needed)

[sqlfluff]
templater = jinja
dialect = tsql
indent_unit = space
tab_space_size = 4
verbose = 0

[sqlfluff:rules]
# Only enable minimal formatting rules
L003 = True    # Indentation
L006 = True    # Comma placement
L009 = True    # Joins formatting
L004 = True  # Capitalization consistency (optional)
L010 = True  # Line length

# Disable all other rules
L001 = False
L002 = False
L005 = False
L007 = False
L008 = False
L011 = False
L012 = False

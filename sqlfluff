[sqlfluff]
dialect = tsql  # Set dialect to T-SQL

# Rules to fix only common formatting issues (indentation, commas, joins, etc.)
rules = L003, L006, L009

# Disable rules that might remove blank lines or make unnecessary changes
exclude_rules = L010  # No blank line removal (L010)
max_line_length = 120  # Allow long lines (up to 120 characters)

# Optional customizations for consistent formatting:
indent_unit = space
indent_size = 4  # Use 4 spaces for indentation (T-SQL standard)
